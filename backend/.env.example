# Application Environment
APP_NAME="Paper-to-Structured-Data Engine"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false

# Server Settings
HOST="127.0.0.1"
PORT=8000

# FreeLLMAPI Local Gateway
FREELLM_BASE_URL="http://127.0.0.1:3001/v1"
FREELLM_API_KEY="your-freellmapi-unified-key"
FREELLM_MODEL_A="google/gemini-2.0-flash-exp:free"
FREELLM_MODEL_B="qwen/qwen-2.5-vl-72b-instruct:free"
FREELLM_MODEL_C_STRUCT="auto"
FREELLM_TIMEOUT_SECONDS=15.0

# Database & Storage
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
MAX_IMAGE_SIZE_MB=10
